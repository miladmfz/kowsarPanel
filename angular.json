{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "KowsarPanel": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "polyfills": [],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": [
                  "libs/**/*",
                  "js/**/*",
                  "configs/**/*",
                  "config_bak.json"
                ]
              },
              {
                "glob": "apexcharts.min.js",
                "input": "src/assets/libs/apexcharts",
                "output": "assets/libs/apexcharts"
              },
              {
                "glob": "**/*",
                "input": "public",
                "output": "."
              },
              "src/favicon.ico"
            ],
            "styles": [
              "src/assets/libs/sweetalert2/sweetalert2.min.css",
              "src/assets/libs/simplebar/simplebar.min.css",
              "src/styles.scss",
              "src/assets/css/theme-fix.css"
            ],
            "scripts": [
              "src/assets/libs/bootstrap/js/bootstrap.bundle.min.js",
              "src/assets/libs/sweetalert2/sweetalert2.min.js",
              "src/assets/libs/simplebar/simplebar.min.js"
            ],
            "allowedCommonJsDependencies": [
              "jalaali-js",
              "jalali-moment",
              "jalali-ts",
              "jssip",
              "leaflet",
              "leaflet.markercluster",
              "sweetalert2",
              "xml-js"
            ],
            "outputPath": "dist/build"
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "hidden": true,
                "vendor": false
              },
              "namedChunks": false,
              "extractLicenses": true,
              "aot": true,
              "serviceWorker": "ngsw-config.json",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "850kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "100kB",
                  "maximumError": "150kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "KowsarPanel:build:production"
            },
            "development": {
              "buildTarget": "KowsarPanel:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "browsers": "ChromeHeadlessNoSandbox",
            "watch": false,
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/images",
                "output": "assets/images"
              }
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
